/* bz/pages/wallpaperDetail/wallpaperDetail.wxss */

page {
  height: 100%;
  background-color: #1a1a1e;
}

.detail {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

/* 背景：当前壁纸模糊放大铺底，双层交叉渐变 */
.bg {
  position: absolute;
  left: -10%;
  top: -10%;
  width: 120%;
  height: 120%;
  filter: blur(40px);
  opacity: 0;
  transition: opacity 0.6s ease;
}

.bg-show {
  opacity: 1;
}

.bg-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
}

/* 顶部信息区 */
.header {
  position: relative;
  padding: 32rpx 0 8rpx;
  text-align: center;
}

.title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.meta-count {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  margin-right: 20rpx;
}

.meta-pill {
  padding: 4rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 22rpx;
}

/* 下载胶囊：仿 GIF 顶部白色实心按钮 */
.down-pill {
  margin-left: 20rpx;
  padding: 6rpx 28rpx;
  background: #ffffff;
  color: #333333;
  font-weight: bold;
}

/* 卡片轮播：底部无按钮，直接延伸到安全区 */
.card-swiper {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 24rpx 0 calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  height: 100%;
  margin: 0 16rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
  transform: scale(0.92);
  transition: transform 0.3s ease;
}

.card-active {
  transform: scale(1);
}

.card-img {
  width: 100%;
  height: 100%;
}
