<view class="tab-box">
  <scroll-view
    class="left-scroll"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
    scroll-with-animation
    scroll-left="{{navScrollLeft}}"
  >
    <view class="left-list">
      <view
        wx:for="{{types}}"
        wx:key="value"
        data-index="{{index}}"
        class="nav-item {{activeIndex === index ? 'active' : ''}}"
        bindtap="switchCategory"
      >
        <text class="nav-text">{{item.label}}</text>
      </view>
      <!-- 指示器放在列表内随内容滚动，translateX 用相对列表左端的坐标 -->
      <view class="item-active" style="transform: translateX({{indicator.x}}px); width: {{indicator.w}}px;"></view>
    </view>
  </scroll-view>

  <scroll-view
    class="grid-scroll"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
    scroll-with-animation
    scroll-left="{{gridScrollLeft}}"
  >
    <view class="grid-list">
      <view
        wx:for="{{gridState.list}}"
        wx:key="value"
        data-index="{{index}}"
        class="grid-item {{gridState.gridActiveIndex === index ? 'grid-active' : ''}}"
        bindtap="gridSwitchCategory"
      >
        <text class="nav-text">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>
</view>
