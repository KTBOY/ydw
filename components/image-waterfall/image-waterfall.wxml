<!--components/image-waterfall/image-waterfall.wxml-->
<scroll-view
  class="wf"
  scroll-y
  scroll-top="{{scrollTop}}"
  lower-threshold="{{lowerThreshold}}"
  bindscrolltolower="onLower"
  style="--wf-gap: {{gap}}rpx"
>
  <view class="wf-body">
    <view class="wf-col" wx:for="{{cols}}" wx:for-item="col" wx:for-index="ci" wx:key="ci">
      <view
        class="wf-cell"
        wx:for="{{col.list}}"
        wx:for-item="cell"
        wx:key="_wfId"
        data-ci="{{ci}}"
        data-index="{{index}}"
        bindtap="onTap"
      >
        <view class="wf-imgwrap" style="height: {{cell._h}}rpx">
          <view class="wf-sk {{cell._loaded ? 'is-hide' : ''}}"></view>
          <image
            class="wf-img {{cell._loaded ? 'is-show' : ''}}"
            src="{{cell._src}}"
            mode="aspectFill"
            lazy-load
            data-ci="{{ci}}"
            data-index="{{index}}"
            bindload="onLoad"
            binderror="onError"
          />
        </view>
        <view class="wf-title" wx:if="{{showTitle && cell._title}}">{{cell._title}}</view>
      </view>
    </view>
  </view>

  <slot></slot>
</scroll-view>
