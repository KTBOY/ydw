/* components/image-waterfall/image-waterfall.wxss */
/* 可主题化的 CSS 变量（自定义属性可穿透组件边界，父级设置即生效）：
   --wf-gap            间距(默认取 gap 属性)
   --wf-radius         卡片圆角
   --wf-card-bg        卡片背景
   --wf-card-border    卡片边框
   --wf-skeleton-base  骨架底色
   --wf-skeleton-shine 骨架流光色
   --wf-skeleton-glow  骨架中心微光色
   --wf-fade           图片淡入时长
   --wf-title-color    标题颜色
   --wf-title-size     标题字号 */

.wf {
  height: 100%;
  box-sizing: border-box;
}

.wf-body {
  display: flex;
  align-items: flex-start;
  padding: var(--wf-gap, 20rpx);
  padding-bottom: 0;
}

.wf-col {
  flex: 1;
  min-width: 0;
}

.wf-col + .wf-col {
  margin-left: var(--wf-gap, 20rpx);
}

.wf-cell {
  margin-bottom: var(--wf-gap, 20rpx);
  border-radius: var(--wf-radius, 16rpx);
  overflow: hidden;
  background: var(--wf-card-bg, transparent);
  border: var(--wf-card-border, 0 solid transparent);
}

.wf-cell:active {
  opacity: 0.92;
}

.wf-imgwrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--wf-skeleton-base, #edf0f5);
}

.wf-img {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity var(--wf-fade, 0.45s) ease;
}

.wf-img.is-show {
  opacity: 1;
}

/* 骨架屏：底色 + 斜向流光 + 中心微光 */
.wf-sk {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--wf-skeleton-base, #edf0f5);
  background-image: linear-gradient(100deg, rgba(255, 255, 255, 0) 32%, var(--wf-skeleton-shine, rgba(255, 255, 255, 0.55)) 50%, rgba(255, 255, 255, 0) 68%);
  background-size: 200% 100%;
  animation: wf-shimmer 1.3s ease-in-out infinite;
  transition: opacity 0.3s ease;
}

.wf-sk::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 90rpx;
  height: 90rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, var(--wf-skeleton-glow, rgba(0, 0, 0, 0.05)), transparent 70%);
}

.wf-sk.is-hide {
  opacity: 0;
}

@keyframes wf-shimmer {
  0% {
    background-position: 150% 0;
  }
  100% {
    background-position: -50% 0;
  }
}

.wf-title {
  padding: 12rpx 16rpx;
  color: var(--wf-title-color, #333333);
  font-size: var(--wf-title-size, 24rpx);
  line-height: 1.4;
}
