/* game/pages/arrowEscape/index.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f2f3f7;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.back {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 52rpx;
  color: #1b2740;
  font-weight: 700;
}

.level {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b2740;
}

.hearts {
  min-width: 150rpx;
  text-align: right;
}

.mute {
  width: 64rpx;
  text-align: center;
  font-size: 36rpx;
}

.heart {
  font-size: 32rpx;
  margin-left: 4rpx;
}

.heart.on {
  color: #e0533d;
}

.heart.off {
  color: #d8dce4;
}

.tip {
  padding: 4rpx 40rpx 12rpx;
  font-size: 22rpx;
  color: #8a90a0;
  text-align: center;
  line-height: 1.5;
}

.canvas-wrap {
  flex: 1;
  margin: 8rpx 20rpx;
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.controls {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.ctrl-btn {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1b2740;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.ctrl-btn:active {
  opacity: 0.7;
}

/* 弹窗 */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(20, 24, 40, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 560rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.dialog-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1b2740;
}

.dialog-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a90a0;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.dlg-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.dlg-btn.ghost {
  background: #f2f3f7;
  color: #5b6273;
}

.dlg-btn.primary {
  background: #2f6df6;
  color: #ffffff;
}

.dlg-btn:active {
  opacity: 0.85;
}

/* 游玩记录 */
.rec-list {
  max-height: 520rpx;
  margin-top: 8rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 26rpx;
}

.rec-idx {
  width: 44rpx;
  color: #b8bec9;
  font-weight: 700;
  text-align: center;
}

.rec-time {
  flex: 1;
  color: #5b6273;
  margin-left: 8rpx;
}

.rec-level {
  color: #1b2740;
  font-weight: 700;
  margin: 0 16rpx;
}

.rec-res {
  width: 72rpx;
  text-align: center;
  border-radius: 8rpx;
  padding: 4rpx 0;
  font-size: 22rpx;
}

.rec-res.win {
  color: #12a594;
  background: rgba(18, 165, 148, 0.12);
}

.rec-res.lose {
  color: #e0533d;
  background: rgba(224, 83, 61, 0.12);
}

.rec-empty {
  text-align: center;
  color: #9aa0ac;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 弹窗进场动画 */
@keyframes ovIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dlgIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.92); }
  to { opacity: 1; transform: none; }
}

.overlay {
  animation: ovIn 0.18s ease-out;
}

.dialog {
  animation: dlgIn 0.26s cubic-bezier(0.2, 0.8, 0.3, 1.12);
}
