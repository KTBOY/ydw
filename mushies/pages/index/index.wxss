/* mushies/pages/index/index.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f6ece6;
}

.topbar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  background: #fff;
  border-radius: 18rpx;
  padding: 12rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 130, 0.1);
}

.stat-card.time {
  background: #fdeef6;
}

.stat-card.goal {
  background: #f3ecfa;
}

.stat-label {
  font-size: 22rpx;
  color: #a08b96;
}

.stat-value {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #4a3550;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stat-card.time .stat-value {
  color: #b0577a;
}

.stat-card.goal .stat-value {
  font-size: 30rpx;
  line-height: 1.6;
  color: #7a5c96;
}

.subbar {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 24rpx 12rpx;
}

.chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(120, 90, 130, 0.08);
}

.chip::before {
  content: '';
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #cbb6c6;
}

.chip.held::before {
  background: #b06fc9;
}

.chip.next::before {
  background: #b0577a;
}

.chip.found::before {
  background: #e0a95f;
}

.chip-label {
  font-size: 22rpx;
  color: #a08b96;
}

.chip-value {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #4a3550;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chip-img {
  width: 40rpx;
  height: 40rpx;
}

.canvas-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 0 16rpx;
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b39fac;
}

.controls {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.ctrl-btn {
  min-width: 96rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #fff;
  color: #4a3550;
  font-size: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 130, 0.12);
}

.ctrl-btn.grow {
  flex: 1;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(60, 40, 70, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.dialog {
  width: 600rpx;
  background: #fffaf6;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4a3550;
}

.dialog-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #97808f;
}

.dialog-score {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #b0577a;
  line-height: 1.1;
}

.dialog-btns {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.dlg-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.dlg-btn.ghost {
  background: #f0e4ea;
  color: #6b5566;
}

.dlg-btn.primary {
  background: #b06fc9;
  color: #fff;
}

.rec-list {
  max-height: 520rpx;
  margin-top: 20rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid #f1e5ea;
  font-size: 26rpx;
  color: #4a3550;
}

.rec-idx {
  width: 48rpx;
  color: #b39fac;
}

.rec-score {
  flex: 0 0 130rpx;
  text-align: left;
  font-weight: 700;
}

.rec-meta {
  flex: 1;
  font-size: 22rpx;
  color: #97808f;
}

.rec-time {
  font-size: 22rpx;
  color: #b39fac;
}

.rec-empty {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #b39fac;
}

/* ---------- 首页（title） ---------- */
.home {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 56rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fdf3ee 0%, #f7e4ec 55%, #efd9e6 100%);
}

.home-mute {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 130, 0.15);
}

.home-poster {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(120, 90, 130, 0.25);
}

.home-title {
  margin-top: 34rpx;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #4a3550;
  line-height: 1.1;
}

.home-title-cn {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: #b0577a;
}

.home-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #97808f;
  text-align: center;
}

.home-best {
  margin-top: 20rpx;
  padding: 8rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #b0577a;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 130, 0.12);
}

.home-start {
  margin-top: 34rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #b06fc9;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 0 10rpx 26rpx rgba(176, 111, 201, 0.4);
}

.home-row {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.home-ghost {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: #6b5566;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 130, 0.12);
}

/* ---------- 玩法说明 ---------- */
.help-body {
  margin-top: 20rpx;
  text-align: left;
}

.help-p {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b5566;
}
