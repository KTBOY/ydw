<!--mushies/pages/index/index.wxml-->
<view class="page {{reducedMotion ? 'rm' : ''}}">
  <!-- 原版竖屏 HUD：紫绒 header band 内两行浮动小卡，右上角 44×52 图标暂停键 -->
  <view class="hud">
    <view class="hud-row">
      <view class="card">
        <view class="cap">得分</view>
        <view class="val">{{score}}</view>
      </view>
      <view class="card time">
        <view class="val big">{{timeText}}</view>
      </view>
      <view class="pause" hover-class="pause-press" bindtap="onPause">
        <view class="pb"></view>
        <view class="pb"></view>
      </view>
    </view>
    <view class="hud-row">
      <view class="card named">
        <image class="ico" src="/mushies/images/{{goalKey}}.png" mode="aspectFit" />
        <text class="cap">目标</text>
        <text class="val">{{goalText}}</text>
      </view>
      <view class="card named">
        <image class="ico" src="/mushies/images/{{nextKey}}.png" mode="aspectFit" />
        <text class="cap">下一个</text>
        <text class="val">{{nextName}}</text>
      </view>
    </view>
  </view>

  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="gameCanvas"
      class="canvas"
      hidden="{{status !== 'playing' || showRecords || showPause || showHelp || showSettings}}"
      bindtouchstart="onTouch"
      bindtouchmove="onTouch"
      bindtouchend="onTouch"
      bindtouchcancel="onTouchCancel"
    ></canvas>
    <view class="hint">{{hint}}</view>
  </view>

  <view class="foot"></view>

  <view class="overlay" wx:if="{{status==='lose'}}">
    <view class="dialog">
      <view class="dialog-title">游戏结束</view>
      <view class="dialog-desc">{{reasonText}}</view>
      <view class="dialog-score">{{score}}</view>
      <view class="dialog-desc">{{summary}}</view>
      <view class="dialog-btns">
        <view class="dlg-btn ghost" bindtap="onShowRecords">看记录</view>
        <button class="dlg-btn ghost share-btn" open-type="share">分享</button>
        <view class="dlg-btn primary" bindtap="onRestart">再来一局</view>
      </view>
    </view>
  </view>

  <view class="overlay" wx:if="{{showRecords}}" bindtouchstart="onMaskTouchStart" catchtap="onCloseRecords">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">🏆 最高分</view>
      <scroll-view wx:if="{{records.length}}" scroll-y class="rec-list">
        <view class="rec-item" wx:for="{{records}}" wx:key="runId">
          <text class="rec-idx">{{index + 1}}</text>
          <text class="rec-score">{{item.score}}</text>
          <text class="rec-meta">合成 {{item.merges}} 次 · {{item.duration}}s</text>
          <text class="rec-time">{{item.timeText}}</text>
        </view>
      </scroll-view>
      <view wx:else class="rec-empty">还没有成绩，先玩一局吧</view>
      <view class="dialog-btns">
        <view class="dlg-btn primary" bindtap="onCloseRecords">关闭</view>
      </view>
    </view>
  </view>

  <!-- 首页（对应原版 route=title 的竖屏/mobile 分支）：整屏 key art + 灯牌 + 缎带 + 底部糖果菜单 -->
  <view class="home" wx:if="{{status === 'title'}}">
    <image class="hm-art" src="/mushies/images/title.jpg" mode="aspectFill" />

    <view class="hm-hearts">
      <view
        class="hm-rise"
        wx:for="{{hearts}}"
        wx:key="index"
        style="left:{{item.left}}%;animation-duration:{{item.riseDur}}s;animation-delay:-{{item.riseDelay}}s"
      >
        <view
          class="hm-heart"
          style="color:{{item.color}};font-size:{{item.size}}rpx;animation-duration:{{item.swayDur}}s;animation-delay:-{{item.swayDelay}}s"
          >♥</view
        >
      </view>
    </view>

    <view class="hm-scrim"></view>

    <view class="hm-marquee">
      <view
        class="hm-bulb"
        wx:for="{{bulbs}}"
        wx:key="index"
        style="left:{{item.x}}rpx;top:{{item.y}}rpx;animation-delay:-{{item.delay}}s"
      ></view>
      <view class="hm-logo-wrap">
        <view class="hm-logo">Mushies</view>
        <view class="hm-shine"></view>
      </view>
    </view>

    <view class="hm-ribbon">
      <view class="hm-tail hm-tail-l"></view>
      <view class="hm-tail hm-tail-r"></view>
      <view class="hm-body">
        <view class="hm-tagline">相同 Mushies，合成更大惊喜。</view>
      </view>
    </view>

    <view class="hm-menu">
      <view class="hm-btn hm-primary" hover-class="hm-press" hover-stay-time="80" bindtap="onStart">开始合成</view>
      <view class="hm-btn hm-secondary" hover-class="hm-press" hover-stay-time="80" bindtap="onShowRecords"
        >排行榜</view
      >
      <view class="hm-btn hm-secondary" hover-class="hm-press" hover-stay-time="80" bindtap="onShowHelp">玩法说明</view>
      <view class="hm-btn hm-secondary" hover-class="hm-press" hover-stay-time="80" bindtap="onShowSettings">设置</view>
    </view>

    <view class="hm-curtain"></view>
  </view>

  <!-- 玩法说明 -->
  <view class="overlay" wx:if="{{showHelp}}" bindtouchstart="onMaskTouchStart" catchtap="onCloseHelp">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">玩法说明</view>
      <view class="help-body">
        <view class="help-p">1. 在柜面上拖动瞄准，松手投放 Mushies。</view>
        <view class="help-p">2. 两个相同 Mushies 相碰，合成为更大的蘑菇伙伴。</view>
        <view class="help-p">3. 达成每个目标，下一目标更大，并增加 1 分钟。</view>
        <view class="help-p">4. 让 Mushies 堆保持在安全线下；开局 3 分钟，超时或溢出本局结束。</view>
        <view class="help-p">清场孢子：堆接近安全线时每局一次，投放 5 秒后爆开清除附近 Mushies。</view>
      </view>
      <view class="dialog-btns">
        <view class="dlg-btn primary" bindtap="onCloseHelp">知道了</view>
      </view>
    </view>
  </view>

  <!-- 设置（原版 Settings 弹框的移动端子集：音频静音 + 减少动效） -->
  <view class="overlay" wx:if="{{showSettings}}" bindtouchstart="onMaskTouchStart" catchtap="onCloseSettings">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">设置</view>
      <view class="set-row">
        <view class="set-label">音效静音</view>
        <switch checked="{{muted}}" color="#f596b0" bindchange="onToggleMute" />
      </view>
      <view class="set-row">
        <view class="set-label">减少动效</view>
        <switch checked="{{reducedMotion}}" color="#f596b0" bindchange="onToggleReducedMotion" />
      </view>
      <view class="set-note">减少动效会停掉灯牌跑马灯、飘升爱心与入场动画。</view>
      <view class="dialog-btns">
        <view class="dlg-btn primary" bindtap="onCloseSettings">关闭</view>
      </view>
    </view>
  </view>

  <!-- 暂停：原版移动端是底部 MobileSheet（奶白底 + 紫绒标题带 + 返回键 + 竖排按钮） -->
  <view class="sheet-mask" wx:if="{{showPause}}" bindtouchstart="onMaskTouchStart" catchtap="onResume">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">已暂停</view>
        <view class="sheet-back" hover-class="sheet-back-press" bindtap="onResume">返回</view>
      </view>
      <view class="sheet-desc">Mushies 堆等你回来。</view>
      <view class="sheet-body">
        <view class="hm-btn hm-primary" hover-class="hm-press" bindtap="onResume">继续合成</view>
        <view class="hm-btn hm-secondary" hover-class="hm-press" bindtap="onRestart">重新开始</view>
        <view class="hm-btn hm-secondary" hover-class="hm-press" bindtap="onShowSettings">设置</view>
        <view class="hm-btn hm-secondary" hover-class="hm-press" bindtap="onGoHome">返回主菜单</view>
      </view>
    </view>
  </view>
</view>
