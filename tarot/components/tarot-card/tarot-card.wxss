.tcard {
  position: relative;
  width: 100%;
  height: 100%;
}

.tcard-frame {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 14rpx;
  background: #f5f0e6;
  border-radius: 24rpx;
  border: 1rpx solid rgba(202, 164, 90, 0.6);
  box-shadow:
    0 10rpx 44rpx rgba(0, 0, 0, 0.65),
    inset 0 0 22rpx rgba(112, 84, 32, 0.16);
}

/* 内圈金线：与首页牌面的双线描边保持一致 */
.tcard-frame::before {
  content: '';
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  right: 5rpx;
  bottom: 5rpx;
  border: 1rpx solid rgba(202, 164, 90, 0.4);
  border-radius: 18rpx;
  pointer-events: none;
}

.tcard-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 12rpx;
}

.tcard-img.rev {
  transform: rotate(180deg);
}

.corner {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  z-index: 2;
}

.c-tl {
  top: 22rpx;
  left: 22rpx;
}

.c-tr {
  top: 22rpx;
  right: 22rpx;
  transform: rotate(90deg);
}

.c-br {
  bottom: 22rpx;
  right: 22rpx;
  transform: rotate(180deg);
}

.c-bl {
  bottom: 22rpx;
  left: 22rpx;
  transform: rotate(270deg);
}

.tcard-plate {
  position: absolute;
  left: 50%;
  bottom: -40rpx;
  transform: translateX(-50%);
  background: #0a0a0f;
  border: 2rpx solid #c9a84c;
  border-radius: 8rpx;
  padding: 10rpx 30rpx;
  color: #e8d48b;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
  z-index: 3;
}
