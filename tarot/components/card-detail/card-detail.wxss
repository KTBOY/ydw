.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel {
  width: 600rpx;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: #101018;
  border: 1rpx solid rgba(201, 168, 76, 0.4);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 32rpx;
}

.panel-state {
  font-size: 24rpx;
  color: #e8d48b;
  border: 1rpx solid rgba(201, 168, 76, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.panel-state.rev {
  color: #b8b2a4;
}

.panel-card {
  width: 300rpx;
  height: 500rpx;
  border-radius: 16rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(201, 168, 76, 0.5);
}

.panel-card.rev-img {
  transform: rotate(180deg);
}

.panel-keywords {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.keyword {
  font-size: 22rpx;
  color: #c9a84c;
  border: 1rpx solid rgba(201, 168, 76, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 20rpx;
}

.panel-meaning {
  max-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #e0dcd0;
  text-align: justify;
}

.panel-actions {
  display: flex;
  gap: 20rpx;
}

.action {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
}
