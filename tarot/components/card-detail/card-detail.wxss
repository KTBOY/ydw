.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: maskIn 0.24s ease both;
}

@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.panel {
  width: 600rpx;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: #101018;
  border: 1rpx solid rgba(201, 168, 76, 0.4);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: panelIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) 0.04s both;
}

@keyframes panelIn {
  from {
    opacity: 0;
    transform: translateY(48rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 84rpx;
}

.panel-title {
  font-size: 32rpx;
}

.panel-state {
  font-size: 24rpx;
  color: #e8d48b;
  border: 1rpx solid rgba(201, 168, 76, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.panel-state.rev {
  color: #b8b2a4;
}

.panel-card {
  width: 300rpx;
  height: 500rpx;
  border-radius: 16rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(201, 168, 76, 0.5);
}

.panel-card.rev-img {
  transform: rotate(180deg);
}

.panel-keywords {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.keyword {
  font-size: 22rpx;
  color: #c9a84c;
  border: 1rpx solid rgba(201, 168, 76, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 20rpx;
}

.panel-meaning {
  max-height: 46vh;
}

.meaning-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #e0dcd0;
  text-align: justify;
}

.sec-title {
  font-size: 24rpx;
  color: #c9a84c;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.sec-body {
  font-size: 26rpx;
  color: #e0dcd0;
}

.sec-body.guidance {
  color: #e8d48b;
}

.save-fab {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #e8d48b;
  background: rgba(201, 168, 76, 0.16);
  border: 1rpx solid rgba(201, 168, 76, 0.45);
  border-radius: 50%;
}

.panel {
  position: relative;
}

.panel-actions {
  display: flex;
  gap: 20rpx;
}

.action {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
}
