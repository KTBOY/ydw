@import '/tarot/styles/theme.wxss';

.profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 64rpx 0 40rpx;
}

.medallion {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 2rpx solid var(--tarot-line);
  background: radial-gradient(circle at 50% 35%, rgba(201, 168, 76, 0.35), rgba(10, 10, 15, 0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--tarot-gold-light);
}

.profile-title {
  font-size: 40rpx;
}

.stats-row {
  display: flex;
  padding: 24rpx 64rpx 48rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 56rpx;
  color: var(--tarot-gold-light);
}

.stat-label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 64rpx;
}
