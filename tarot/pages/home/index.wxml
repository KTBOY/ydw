<view class="tarot-page page-shell">
  <view class="panels">
    <!-- 首页：今日之牌 -->
    <scroll-view scroll-y class="panel {{panels.home}}">
      <view class="panel-pad home-wrap">
        <scroll-view
          class="month-strip"
          scroll-x
          enhanced="{{true}}"
          show-scrollbar="{{false}}"
          scroll-with-animation
          scroll-left="{{monthScrollLeft}}"
        >
          <view
            wx:for="{{months}}"
            wx:key="index"
            class="month-item {{item.index === viewMonth ? 'on' : ''}}"
            data-m="{{item.index}}"
            bindtap="onPickMonth"
            >{{item.name}}</view
          >
        </scroll-view>

        <image class="orn-fan" src="/tarot/images/decor/orn-fan.png" mode="aspectFill" />
        <view class="year-label">{{yearLabel}}</view>

        <view class="card-stage">
          <image class="peek left" src="/tarot/images/decor/card-side-l.png" mode="aspectFill" />
          <image class="peek right" src="/tarot/images/decor/card-side-r.png" mode="aspectFill" />

          <view class="card3d {{cardAnim ? 'enter' : ''}}">
            <view class="card-inner {{isRevealed || !isCurrentMonth ? 'flipped' : ''}}" bindtap="onCardTap">
              <view class="card-face card-back-face">
                <view class="back-art">
                  <text class="back-glyph g1">✦</text>
                  <text class="back-glyph g2">❂</text>
                  <text class="back-glyph g3">☾</text>
                </view>
              </view>
              <view class="card-face card-front-face">
                <view class="card-frame">
                  <image class="rosette tl" src="/tarot/images/decor/rosette.png" mode="aspectFill" />
                  <image class="rosette tr" src="/tarot/images/decor/rosette.png" mode="aspectFill" />
                  <image class="rosette bl" src="/tarot/images/decor/rosette.png" mode="aspectFill" />
                  <image class="rosette br" src="/tarot/images/decor/rosette.png" mode="aspectFill" />
                  <view class="card-topband">{{card.nameCn}}</view>
                  <view class="card-window">
                    <image class="card-img {{card.isReversed ? 'rev' : ''}}" src="{{img}}" mode="aspectFill" />
                    <view class="card-shade"></view>
                    <view class="card-numeral">{{numeral}}</view>
                  </view>
                  <view class="card-plaque">{{card.nameCn}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="date-line">{{dateLine}}</view>
        <view class="time-line">{{timeLine}}</view>
        <view class="reveal-hint" wx:if="{{isCurrentMonth && !isRevealed}}">轻触卡片 · 揭示今日指引</view>
        <view class="browse-hint" wx:else>轻触卡片查看牌意解读</view>
      </view>
    </scroll-view>

    <!-- 历史 -->
    <scroll-view scroll-y class="panel {{panels.history}}">
      <view class="panel-pad">
        <view class="hist-head">
          <view class="hist-arrow" bindtap="prevMonth">←</view>
          <text class="hist-month gold-title">{{monthLabel}}</text>
          <view class="hist-arrow" bindtap="nextMonth">→</view>
        </view>

        <view class="hist-week">
          <text wx:for="{{weekDays}}" wx:key="*this" class="week-cell dim-text">{{item}}</text>
        </view>

        <view class="hist-grid">
          <block wx:for="{{grid}}" wx:key="key">
            <view
              wx:if="{{!item.empty}}"
              class="day-cell {{item.hasRecord ? 'has' : ''}}"
              data-cell="{{item}}"
              bindtap="onDay"
            >
              <text class="day-num">{{item.day}}</text>
              <text wx:if="{{item.hasRecord}}" class="day-dot">✦</text>
            </view>
            <view wx:else class="day-cell empty"></view>
          </block>
        </view>

        <view class="hist-tip dim-text">点击带 ✦ 的日期回看当日之牌</view>
      </view>
    </scroll-view>

    <!-- 我的 -->
    <scroll-view scroll-y class="panel {{panels.profile}}">
      <view class="panel-pad">
        <view class="profile-head">
          <view class="medallion">✦</view>
          <text class="gold-title profile-title">我的塔罗</text>
        </view>

        <view class="stats-row">
          <view class="stat">
            <text class="stat-num">{{stats.total}}</text>
            <text class="stat-label dim-text">抽牌次数</text>
          </view>
          <view class="stat">
            <text class="stat-num">{{stats.streak}}</text>
            <text class="stat-label dim-text">连续天数</text>
          </view>
          <view class="stat">
            <text class="stat-num">{{stats.savedCount}}</text>
            <text class="stat-label dim-text">收藏牌数</text>
          </view>
        </view>

        <view class="entry-list">
          <view class="gold-btn entry" bindtap="goSaved">☾ 收藏之牌</view>
          <view class="gold-btn entry" bindtap="goMember">✧ 会员中心</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <card-detail
    show="{{showDetail}}"
    card="{{detailCard}}"
    isReversed="{{detailReversed}}"
    actionText="{{detailAction}}"
    bindclose="closeDetail"
    bindaction="onDetailAction"
  />
  <tabbar active="{{tab}}" use-event bindchange="onTabChange" />
</view>
