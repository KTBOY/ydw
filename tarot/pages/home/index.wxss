@import '/tarot/styles/theme.wxss';

/* ===== 容器壳：三面板页内切换（替代 redirectTo，消除切换卡顿） ===== */

.page-shell {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
}

.panels {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateX(70rpx);
  transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.panel.off-l {
  transform: translateX(-70rpx);
}

.panel.on {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.panel-pad {
  padding: 0 0 calc(240rpx + env(safe-area-inset-bottom));
}

/* ===== 首页：顶部月份条 ===== */

.home-wrap {
  padding-top: 16rpx;
}

.month-strip {
  width: 100%;
  height: 96rpx;
  white-space: nowrap;
}

.month-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 96rpx;
  font-size: 32rpx;
  color: var(--tarot-gold);
  transition: color 0.25s ease, font-size 0.25s ease;
}

.month-item.on {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  text-shadow: 0 0 20rpx rgba(255, 255, 255, 0.4);
}

/* ===== 首页：金羽扇纹饰（设计切图）与年份 ===== */

.orn-fan {
  display: block;
  width: 750rpx;
  height: 91rpx;
  margin: 18rpx auto 0;
}

.year-label {
  margin-top: 6rpx;
  text-align: center;
  font-size: 31rpx;
  color: var(--tarot-gold);
  letter-spacing: 10rpx;
  text-indent: 10rpx;
}

/* ===== 首页：卡牌舞台（两侧露出的装饰卡为设计切图） ===== */

.card-stage {
  position: relative;
  height: 836rpx;
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.peek {
  position: absolute;
  top: 50%;
  width: 142rpx;
  height: 812rpx;
  transform: translateY(-50%);
  z-index: 1;
}

.peek.left {
  left: 0;
}

.peek.right {
  right: 0;
}

/* ===== 中央大卡：3D 翻牌 ===== */

.card3d {
  position: relative;
  z-index: 2;
  width: 477rpx;
  height: 767rpx;
  perspective: 1800rpx;
}

.card3d.enter {
  animation: dealIn 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes dealIn {
  0% {
    opacity: 0;
    transform: translateY(-36rpx) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
}

.card-inner.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 牌背：奶白外框 + 暗色描金纹 */
.card-back-face {
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #ffffff, #f3eede);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.6);
}

.back-art {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 34rpx;
  background:
    radial-gradient(circle at 50% 50%, rgba(201, 168, 76, 0.3) 0%, transparent 45%),
    repeating-radial-gradient(circle at 50% 50%, rgba(201, 168, 76, 0.16) 0 8rpx, transparent 8rpx 20rpx),
    linear-gradient(180deg, #131019 0%, #0a0810 100%);
}

.back-art::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.55);
  border-radius: 6rpx;
}

.back-glyph {
  color: #d9b968;
}

.back-glyph.g1 {
  font-size: 44rpx;
}

.back-glyph.g2 {
  font-size: 92rpx;
  text-shadow: 0 0 28rpx rgba(217, 185, 104, 0.7);
}

.back-glyph.g3 {
  font-size: 44rpx;
}

/* 牌面：白框 + 顶部卡名带 + 四角雕花 + 底部铭牌（尺寸取自设计图） */
.card-front-face {
  transform: rotateY(180deg);
}

.card-frame {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 19rpx 32rpx 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f4e9 70%, #efe9d8 100%);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.65);
}

.card-topband {
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
  color: #463a22;
  white-space: nowrap;
  overflow: hidden;
}

.card-window {
  position: relative;
  width: 100%;
  height: calc(100% - 56rpx);
  border-radius: 6rpx;
  overflow: hidden;
  background: #0e0c14;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: sepia(0.22) saturate(1.12) contrast(1.02);
}

.card-img.rev {
  transform: rotate(180deg);
}

.card-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(6, 5, 12, 0.45), rgba(6, 5, 12, 0.12) 55%, transparent);
  pointer-events: none;
}

.card-numeral {
  position: absolute;
  top: 106rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.95);
  font-size: 42rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.85);
}

.rosette {
  position: absolute;
  width: 58rpx;
  height: 58rpx;
  z-index: 3;
}

.rosette.tl {
  top: 2rpx;
  left: 2rpx;
}

.rosette.tr {
  top: 2rpx;
  right: 2rpx;
}

.rosette.bl {
  bottom: 2rpx;
  left: 2rpx;
}

.rosette.br {
  bottom: 2rpx;
  right: 2rpx;
}

.card-plaque {
  position: absolute;
  z-index: 4;
  left: 50%;
  bottom: -46rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
  width: 56%;
  padding: 8rpx 12rpx;
  background: #07070a;
  border: 2rpx solid #caa45a;
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.55),
    inset 0 0 0 4rpx #07070a,
    inset 0 0 0 5rpx rgba(202, 164, 90, 0.7);
  text-align: center;
  color: #f3efe4;
  font-size: 27rpx;
  line-height: 1.3;
}

/* ===== 首页：日期与时间 ===== */

.date-line {
  margin-top: 91rpx;
  text-align: center;
  font-size: 30rpx;
  color: #b9c1cd;
  letter-spacing: 3rpx;
}

.time-line {
  margin-top: 34rpx;
  text-align: center;
  font-size: 27rpx;
  color: #cdbd8a;
  letter-spacing: 6rpx;
}

.reveal-hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(141, 137, 125, 0.75);
  letter-spacing: 4rpx;
  animation: hintPulse 2.4s ease-in-out infinite;
}

.browse-hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(141, 137, 125, 0.7);
  letter-spacing: 4rpx;
}

@keyframes hintPulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

/* ===== 历史面板 ===== */

.hist-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 56rpx 0 24rpx;
}

.hist-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--tarot-line);
  border-radius: 50%;
  color: var(--tarot-gold);
  font-size: 32rpx;
}

.hist-arrow:active {
  opacity: 0.6;
}

.hist-month {
  font-size: 36rpx;
  min-width: 260rpx;
  text-align: center;
}

.hist-week {
  display: flex;
  padding: 0 32rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.hist-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

.day-cell {
  width: calc(100% / 7);
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.day-cell.empty {
  visibility: hidden;
}

.day-num {
  font-size: 28rpx;
  color: var(--tarot-dim);
}

.day-cell.has .day-num {
  color: var(--tarot-text);
}

.day-dot {
  font-size: 20rpx;
  color: var(--tarot-gold);
  line-height: 24rpx;
}

.hist-tip {
  text-align: center;
  font-size: 24rpx;
  padding-top: 40rpx;
  letter-spacing: 2rpx;
}

/* ===== 我的面板 ===== */

.profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 72rpx 0 40rpx;
}

.medallion {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #4a3610;
  background: radial-gradient(circle at 50% 30%, #fbefc5 0%, #eed795 28%, #d4af5a 52%, #8a681f 80%, #55400f 100%);
  border: 2rpx solid #a8863a;
  box-shadow:
    0 0 28rpx rgba(232, 205, 120, 0.35),
    inset 0 6rpx 10rpx rgba(255, 248, 215, 0.75),
    inset 0 -8rpx 16rpx rgba(90, 62, 8, 0.55);
}

.profile-title {
  font-size: 40rpx;
}

.stats-row {
  display: flex;
  padding: 24rpx 64rpx 48rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 56rpx;
  color: var(--tarot-gold-light);
}

.stat-label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 64rpx;
}
