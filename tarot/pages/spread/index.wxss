@import '/tarot/styles/theme.wxss';

.spread-title {
  display: block;
  text-align: center;
  font-size: 44rpx;
  padding-top: 48rpx;
}

.spread-sub {
  display: block;
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0 40rpx;
}

.spread-input {
  margin: 0 64rpx;
  height: 84rpx;
  border: 1rpx solid var(--tarot-line);
  border-radius: 42rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  color: var(--tarot-text);
  background: rgba(16, 16, 24, 0.6);
}

.spread-ph {
  color: var(--tarot-dim);
}

.draw-btn {
  margin: 40rpx 64rpx 0;
}

.spread-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 56rpx 24rpx 0;
}

.spread-item {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 60rpx;
}

.spread-flip {
  position: relative;
  width: 200rpx;
  height: 330rpx;
  transform-style: preserve-3d;
  transition: transform 0.5s ease;
}

.spread-flip.on {
  transform: rotateY(180deg);
}

.spread-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.spread-front {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform: rotateY(180deg);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.spread-pos {
  font-size: 26rpx;
  color: var(--tarot-gold);
  letter-spacing: 4rpx;
}

.comb {
  margin: 64rpx 64rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comb-title {
  text-align: center;
  font-size: 32rpx;
}

.comb-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border: 1rpx solid var(--tarot-line);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  background: rgba(16, 16, 24, 0.55);
}

.comb-pos {
  font-size: 26rpx;
  color: var(--tarot-gold-light);
  letter-spacing: 2rpx;
}

.comb-body {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--tarot-text);
}

.again-btn {
  margin-top: 16rpx;
}
