@import '/tarot/styles/theme.wxss';

.hist-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 48rpx 0 24rpx;
}

.hist-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--tarot-line);
  border-radius: 50%;
  color: var(--tarot-gold);
  font-size: 32rpx;
}

.hist-month {
  font-size: 36rpx;
  min-width: 220rpx;
  text-align: center;
}

.hist-week {
  display: flex;
  padding: 0 32rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.hist-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

.day-cell {
  width: calc(100% / 7);
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.day-cell.empty {
  visibility: hidden;
}

.day-num {
  font-size: 28rpx;
  color: var(--tarot-dim);
}

.day-cell.has .day-num {
  color: var(--tarot-text);
}

.day-dot {
  font-size: 20rpx;
  color: var(--tarot-gold);
  line-height: 24rpx;
}

.hist-tip {
  text-align: center;
  font-size: 24rpx;
  padding-top: 40rpx;
  letter-spacing: 2rpx;
}
